# Copy to mise.toml (gitignored) and fill in real values. Never commit mise.toml.
[tools]
node = "22"
pnpm = "latest"

[env]
APP_TOKEN = "change-me-openssl-rand-hex-24"
# Optional. Consent code typed on the MCP sign-in page; 16+ chars, different from APP_TOKEN
# (e.g. `openssl rand -hex 24`). MCP sign-in stays disabled while it is empty.
MCP_CONNECT_CODE = ""
# Optional: exact extra OAuth redirect URIs, comma separated (for Gemini, the URL its error shows).
MCP_ALLOWED_REDIRECT_URIS = ""
TMDB_API_TOKEN = "tmdb-v4-read-access-token"
SITE_URL = "https://popcorn.<domain>"
DATABASE_PATH = "./data/popcorn.db"
PORT = "8787"

# Only for `mise run portainer_redeploy`: an access token from Portainer's
# "User settings > Access tokens" and the numeric stack id from the stack's URL.
PORTAINER_URL = "https://your-portainer-host:9443"
PORTAINER_API_KEY = ""
PORTAINER_STACK_ID = ""

[tasks.portainer_redeploy]
description = "Recreate the Portainer stack, re-pulling its image (usage: mise run portainer_redeploy [stack_id])"
run = '''
#!/usr/bin/env bash
set -euo pipefail

stack_id="${1:-$PORTAINER_STACK_ID}"
auth=(-H "X-API-Key: ${PORTAINER_API_KEY}")

stack="$(curl -sf "${auth[@]}" "${PORTAINER_URL}/api/stacks/${stack_id}")"
endpoint_id="$(jq -r '.EndpointId' <<<"$stack")"
env_json="$(jq -c '.Env' <<<"$stack")"
file_content="$(curl -sf "${auth[@]}" "${PORTAINER_URL}/api/stacks/${stack_id}/file" | jq -r '.StackFileContent')"

payload="$(jq -n --arg content "$file_content" --argjson env "$env_json" \
  '{stackFileContent: $content, env: $env, prune: false, pullImage: true}')"

curl -sf -X PUT "${auth[@]}" -H "Content-Type: application/json" \
  "${PORTAINER_URL}/api/stacks/${stack_id}?endpointId=${endpoint_id}" \
  -d "$payload" > /dev/null

echo "Stack ${stack_id} redeployed with the latest image."
'''
